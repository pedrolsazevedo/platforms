ARG BASE_IMAGE=alpine:latest@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b
FROM ${BASE_IMAGE}

ARG OPENSSL_VERSION

LABEL org.label-schema.version="${OPENSSL_VERSION}"

RUN apk update && apk upgrade && \
    apk add --no-cache \
    ${OPENSSL_VERSION:+openssl=${OPENSSL_VERSION}} \
    ${OPENSSL_VERSION:-openssl} \
    curl \
    git \
    vim \
    wget \
    unzip \
    gnupg \
    bind-tools \
    whois \
    bash \
    build-base \
    helm \
    kubectl

COPY build/README-openssl.md /README.md

CMD [ "bash" ]
